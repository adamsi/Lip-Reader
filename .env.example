ANTHROPIC_API_KEY=sk-ant-api03-...
INWORLD_API_KEY=your-inworld-api-key
INWORLD_VOICE_ID=Ashley

# --- Backend auth (Clerk) ---
# Leave AUTH_STUB=true for local MVP: tokens are decoded but not signature-verified.
# Set AUTH_STUB=false and provide the JWKS URL + issuer to enforce real verification.
AUTH_STUB=true
# CLERK_JWKS_URL=https://<your-subdomain>.clerk.accounts.dev/.well-known/jwks.json
# CLERK_ISSUER=https://<your-subdomain>.clerk.accounts.dev

# --- Database ---
# Defaults to local SQLite if unset. For Supabase use the *Session pooler*
# string (Dashboard -> Connect -> Session pooler), NOT the direct
# db.<ref>.supabase.co host (that one is IPv6-only). Note the user is
# postgres.<project-ref> and the host is aws-1-<region>.pooler.supabase.com.
# DATABASE_URL=postgresql://postgres.<ref>:<pw>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require
